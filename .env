# ==============================================================================
# WEDA-LLM-BASE Pipeline — environment template
#
# Fill in the placeholders, then run:
#     ./build.sh
# ==============================================================================

# ── Image ─────────────────────────────────────────────────────────────────────
WEDA_LLM_IMAGE=edgesync.azurecr.io/advantech/cognitive-rag-llm-via-vllm-on-nvidia-jetson-thor:1.0.0-Ubuntu24.04-ARM

# ── Container Identity ────────────────────────────────────────────────────────
WEDA_LLM_CONTAINER_NAME=weda-edge-llm
WEDA_LLM_PORT=9000
# Bind address for the vLLM API. Both services run with network_mode: host, so
# 0.0.0.0 would expose the unauthenticated inference endpoint on every interface
# of the device. Open WebUI reaches it over 127.0.0.1, so loopback is enough.
# Set to 0.0.0.0 only if you need to call the raw API from another machine.
WEDA_LLM_HOST=127.0.0.1

# ── Model Configuration ───────────────────────────────────────────────────────
# Note: Model parameters (name, memory, token limits) have been migrated to:
# config/llm_config.yaml

# ──MOE Cache Configuration─────────────────────────────────────────────────────
MOE_CONFIGS_DIR=./artifacts/moe-configs

# ── HuggingFace ───────────────────────────────────────────────────────────────
#HF_TOKEN=
HF_HUB_OFFLINE=1
# Point this to your host's actual model cache folder
HF_CACHE=/home/<user-name>/.cache/huggingface

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_MAX_SIZE=20m
LOG_MAX_FILE=3

